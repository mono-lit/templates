{
  "name": "mono-templates",
  "private": true,
  "packageManager": "pnpm@10.7.0",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "check": "vp check",
    "fmt": "vp fmt",
    "run": "vp run",
    "test": "vp test",
    "lith:sync": "node scripts/make-liths.mjs",

    "dev:nuxt-host": "vp run --filter nuxt-host dev",
    "dev:prod:nuxt-host": "vp run --filter nuxt-host dev:prod",
    "build:dev:nuxt-host": "vp run --filter nuxt-host build:dev",
    "build:prod:nuxt-host": "vp run --filter nuxt-host build:prod",
    "preview:dev:nuxt-host": "vp run --filter nuxt-host preview:dev",
    "preview:prod:nuxt-host": "vp run --filter nuxt-host preview:prod",

    "dev:nuxt-remote": "vp run --filter nuxt-remote dev",
    "dev:prod:nuxt-remote": "vp run --filter nuxt-remote dev:prod",
    "build:dev:nuxt-remote": "vp run --filter nuxt-remote build:dev",
    "build:prod:nuxt-remote": "vp run --filter nuxt-remote build:prod",
    "preview:dev:nuxt-remote": "vp run --filter nuxt-remote preview:dev",
    "preview:prod:nuxt-remote": "vp run --filter nuxt-remote preview:prod",

    "dev:vue-host": "vp run --filter vue-host dev",
    "dev:prod:vue-host": "vp run --filter vue-host dev:prod",
    "build:dev:vue-host": "vp run --filter vue-host build:dev",
    "build:prod:vue-host": "vp run --filter vue-host build:prod",
    "preview:dev:vue-host": "vp run --filter vue-host preview:dev",
    "preview:prod:vue-host": "vp run --filter vue-host preview:prod",

    "dev:vue-remote": "vp run --filter vue-remote dev",
    "dev:prod:vue-remote": "vp run --filter vue-remote dev:prod",
    "build:dev:vue-remote": "vp run --filter vue-remote build:dev",
    "build:prod:vue-remote": "vp run --filter vue-remote build:prod",
    "preview:dev:vue-remote": "vp run --filter vue-remote preview:dev",
    "preview:prod:vue-remote": "vp run --filter vue-remote preview:prod",

    "install:nuxt-lith": "pnpm -C nuxt-lith install",
    "dev:nuxt-lith": "pnpm -C nuxt-lith run dev",
    "dev:prod:nuxt-lith": "pnpm -C nuxt-lith run dev:prod",
    "dev:remote:nuxt-lith": "pnpm -C nuxt-lith run dev:remote",
    "build:dev:nuxt-lith": "pnpm -C nuxt-lith run build:dev",
    "build:prod:nuxt-lith": "pnpm -C nuxt-lith run build:prod",
    "preview:dev:nuxt-lith": "pnpm -C nuxt-lith run preview:dev",
    "preview:prod:nuxt-lith": "pnpm -C nuxt-lith run preview:prod",

    "install:vue-lith": "pnpm -C vue-lith install",
    "dev:vue-lith": "pnpm -C vue-lith run dev",
    "dev:prod:vue-lith": "pnpm -C vue-lith run dev:prod",
    "dev:remote:vue-lith": "pnpm -C vue-lith run dev:remote",
    "build:dev:vue-lith": "pnpm -C vue-lith run build:dev",
    "build:prod:vue-lith": "pnpm -C vue-lith run build:prod",
    "preview:dev:vue-lith": "pnpm -C vue-lith run preview:dev",
    "preview:prod:vue-lith": "pnpm -C vue-lith run preview:prod",

    "install:nuxt-lith-mini": "pnpm -C nuxt-lith-mini install",
    "dev:nuxt-lith-mini": "pnpm -C nuxt-lith-mini run dev",
    "dev:prod:nuxt-lith-mini": "pnpm -C nuxt-lith-mini run dev:prod",
    "build:dev:nuxt-lith-mini": "pnpm -C nuxt-lith-mini run build:dev",
    "build:prod:nuxt-lith-mini": "pnpm -C nuxt-lith-mini run build:prod",
    "preview:dev:nuxt-lith-mini": "pnpm -C nuxt-lith-mini run preview:dev",
    "preview:prod:nuxt-lith-mini": "pnpm -C nuxt-lith-mini run preview:prod",

    "install:vue-lith-mini": "pnpm -C vue-lith-mini install",
    "dev:vue-lith-mini": "pnpm -C vue-lith-mini run dev",
    "dev:prod:vue-lith-mini": "pnpm -C vue-lith-mini run dev:prod",
    "build:dev:vue-lith-mini": "pnpm -C vue-lith-mini run build:dev",
    "build:prod:vue-lith-mini": "pnpm -C vue-lith-mini run build:prod",
    "preview:dev:vue-lith-mini": "pnpm -C vue-lith-mini run preview:dev",
    "preview:prod:vue-lith-mini": "pnpm -C vue-lith-mini run preview:prod"
  },
  "devDependencies": {
    "@mono-lit/devextreme": "catalog:mono",
    "@mono-lit/utility": "catalog:mono",
    "vite-plus": "^0.3.1"
  }
}
