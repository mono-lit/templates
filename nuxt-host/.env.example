# Base URLs now live in mono.config.ts `env` (non-secret) — not here.
# GitHub token for fetching remote apps (unused until a Nuxt remote exists)
MONO_NUXT_HOST_GITHUB_TOKEN=
# Optional Sentry (prod only)
# Master on/off switch. Set to "true" ONLY in the prod env file (.env), leave it
# out of .env.dev. Sentry init requires this === "true" AND a DSN. Needed because
# `nuxt build` (incl. `build:dev`) is always a production build, so
# import.meta.env.PROD cannot distinguish the two.
VITE_SENTRY_ENABLED=
# Runtime DSN (client) — exposed to import.meta.env via the VITE_ prefix.
VITE_SENTRY_DSN=
# Build-time source-map upload (@sentry/nuxt). Upload is skipped if the token is
# empty. Read from process.env in nuxt.config.ts.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
MONO_REGISTRY_TOKEN=
