{
  "name": "vue-lith-mini",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.7.0",
  "scripts": {
    "dev": "vp run --filter vue-host dev",
    "dev:prod": "vp run --filter vue-host dev:prod",
    "build": "vp run --filter vue-host build",
    "build:dev": "vp run --filter vue-host build:dev",
    "build:prod": "vp run --filter vue-host build:prod",
    "preview:dev": "vp run --filter vue-host preview:dev",
    "preview:prod": "vp run --filter vue-host preview:prod",
    "mono:prepare": "vp run -r mono:prepare"
  },
  "devDependencies": {
    "vite-plus": "1.4.0"
  }
}
