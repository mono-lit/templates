# Same keys, same order in .env (prod), .env.dev (dev) and .env.example.
#   .env.dev -> pnpm dev, build:dev, preview:dev
#   .env     -> pnpm dev:prod, build / build:prod, preview:prod
# Committed: never put a real secret here. Base URLs live in mono.env.ts.
# PORT: hosts 7100, remotes 7101 (a mini remote has no server; it runs on its host).
NODE_ENV="production"
PORT=7100

# Sentry (optional): runs in production builds only when VITE_SENTRY_DSN is set.
VITE_SENTRY_DSN=""
# Build-time source-map upload; skipped while SENTRY_AUTH_TOKEN is empty.
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
