# No base URLs here — the remote ships no backend of its own; everything
# (mock API, fetching entries) merges in from the host via `extends`.
# GitHub token used by `pnpm mono:sync` to clone the private host repo
# (matches `apps[].envToken` in mono.config.ts).
MONO_NUXT_REMOTE_GITHUB_TOKEN=""
MONO_REGISTRY_TOKEN=
