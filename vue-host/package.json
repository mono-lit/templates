{
  "name": "mono-host",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "node:header-size": "node -e \"const { spawn } = require('node:child_process'); const [cmd,...args]=process.argv.slice(1); const child=spawn(cmd,args,{stdio:'inherit',shell:process.platform==='win32',env:{...process.env,NODE_OPTIONS:[process.env.NODE_OPTIONS,'--max-http-header-size=65536'].filter(Boolean).join(' ')}}); child.on('exit',c=>process.exit(c ?? 0));\"",
    "env:dev": "pnpm run node:header-size -- mono env -e .env.dev",
    "env:prod": "pnpm run node:header-size -- mono env -e .env",
    "mono:prepare": "mono prepare",
    "postinstall": "mono prepare",
    "dev": "mono prepare && pnpm run env:dev -- vite",
    "dev:h": "mono prepare && pnpm run env:dev -- vite --host",
    "build": "pnpm run env:prod -- vue-tsc && pnpm run env:prod -- vite build --emptyOutDir",
    "build:dev": "pnpm run env:dev -- vue-tsc && pnpm run env:dev -- vite build --mode development --emptyOutDir",
    "preview": "pnpm run env:prod -- vite preview",
    "preview:dev": "pnpm run env:dev -- vite preview --outDir dist-dev --mode development",
    "odata:gen": "dotenv -e .env.dev odata2ts",
    "mono:sync": "dotenv -e .env.dev -- mono sync && mono prepare"
  },
  "dependencies": {
    "@sentry/integrations": "catalog:frontend",
    "@sentry/vue": "catalog:frontend",
    "@unhead/vue": "catalog:frontend",
    "@vueuse/core": "catalog:frontend",
    "@vueuse/integrations": "catalog:frontend",
    "dotenv": "catalog:dev",
    "jwt-decode": "catalog:frontend",
    "mono-devextreme": "catalog:mono",
    "notivue": "catalog:frontend",
    "pinia": "catalog:frontend",
    "universal-cookie": "catalog:frontend",
    "vue": "catalog:frontend",
    "vue-router": "catalog:frontend",
    "yup": "catalog:frontend"
  },
  "devDependencies": {
    "@iconify/json": "catalog:dev",
    "@odata2ts/http-client-api": "catalog:build",
    "@odata2ts/odata-query-objects": "catalog:build",
    "@odata2ts/odata-service": "catalog:build",
    "@odata2ts/odata2ts": "catalog:build",
    "@sentry/vite-plugin": "catalog:build",
    "@tsconfig/node22": "catalog:dev",
    "@types/node": "catalog:types",
    "@vitejs/plugin-vue": "catalog:build",
    "@vue/tsconfig": "catalog:dev",
    "dotenv-cli": "catalog:dev",
    "mono-helper": "catalog:mono",
    "mono-utils": "catalog:mono",
    "taze": "catalog:dev",
    "typescript": "catalog:dev",
    "unocss": "catalog:build",
    "unplugin-auto-import": "catalog:build",
    "unplugin-vue-components": "catalog:build",
    "vite": "catalog:build",
    "vite-plugin-mkcert": "catalog:build",
    "vite-plugin-vue-devtools": "catalog:build",
    "vite-plugin-vue-layouts-next": "catalog:build",
    "vue-tsc": "catalog:dev"
  }
}
